<header class="sheet-header">
	<ul>
		<li>
			<img
				src="{{actor.img}}"
				data-action="editImage"
				data-edit="img"
				title="{{system.characterName}}"
				height="64"
				width="64"
			/>
			<label for="characterName">
				Character Name
			</label>
			<input
				type="text"
				name="system.characterName"
				class="large"
				value="{{system.characterName}}"
			/>
		</li>
	</ul>
		<ul>
		<li>
			<label for="playerName">
				Player Name
			</label>
			<input
				type="text"
				name="system.playerName"
				class="large"
				value="{{system.playerName}}"
			/>
		</li>
	</ul>
</header>