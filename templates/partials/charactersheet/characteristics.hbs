<section class="characteristics-section">
    <div class="char-box">
        <div class="char-name"> Characteristic </div>
        <div class="char-input"> Score </div>
        <div class="char-modifier"> Modifier </div>
        <div class="char-bonus"> Bonus </div>
    </div>
    {{#each system.charNumbers as | characteristic |}}
        <div class="char-box">
            <div class="char-name">
                <label for="{{this._id}}.{{@key}}">
                    {{@key}}
                </label>
            </div>
            <div class="char-input">
                    <input
                type="number"
                name="system.charNumbers.{{@key}}"
                value="{{characteristic}}"
                />
            </div>
            <div class="char-modifier">{{lookup ../system.charMods @key}}</div>
            <div class="char-bonus">{{lookup ../system.charBonus @key}}</div>
        </div>
    {{/each}}
</section>